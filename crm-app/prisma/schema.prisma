// ============================================================
// CRM Database Schema — Phase 1
// Core loop: Employee adds Customer -> Customer applies for a
// Service (CustomerService record) -> status/reference edited
// as work progresses -> everything is searchable + logged.
//
// This file will grow in later phases (agents, payments,
// commissions, documents, followups, notifications) without
// breaking what's here — new tables/columns only.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  EMPLOYEE
  AGENT
}

enum ServiceStatus {
  NEW
  // Agent-submitted applications start here — awaiting Employee/
  // Admin/Manager accept-or-reject. Deliberately excluded from an
  // agent's pending-payment balance (see lib/agentContext.ts) so
  // submitting work never inflates what an agent owes.
  PENDING_REVIEW
  ASSIGNED
  ACCEPTED
  PROCESSING
  DOCUMENT_REQUIRED
  SUBMITTED
  COMPLETED
  REJECTED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
}

enum AgentStatus {
  ACTIVE
  INACTIVE
}

enum PaymentRequestStatus {
  PENDING_VERIFICATION
  APPROVED
  REJECTED
}

enum ServiceFieldType {
  TEXT
  NUMBER
  DATE
  EMAIL
  PHONE
  PASSWORD
  TEXTAREA
  SELECT
  CHECKBOX
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(EMPLOYEE)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customersCreated       Customer[]        @relation("CustomerCreatedBy")
  customersUpdated       Customer[]        @relation("CustomerUpdatedBy")
  customerServicesAdded  CustomerService[] @relation("CSCreatedBy")
  customerServicesEdited CustomerService[] @relation("CSUpdatedBy")
  assignedServices       CustomerService[] @relation("CSAssignedEmployee")
  agentsCreated          Agent[]           @relation("AgentCreatedBy")
  activityLogs           ActivityLog[]

  // If this User's role is AGENT, this is their linked Agent profile
  // (one login <-> one agent). Null for non-agent users.
  agentProfile Agent? @relation("AgentUserAccount")

  // Payment verification workflow: an agent submits requests under
  // their own user id; an admin/manager verifies them under theirs.
  paymentRequestsSubmitted AgentPaymentRequest[] @relation("PaymentSubmittedBy")
  paymentRequestsVerified  AgentPaymentRequest[] @relation("PaymentVerifiedBy")
  upiConfigsUpdated        UpiConfig[]           @relation("UpiConfigUpdatedBy")

  // Dynamic application field values / documents this user has
  // filled in or uploaded (agent at submission, or staff later).
  fieldValuesEntered ApplicationFieldValue[] @relation("FieldValueUpdatedBy")
  documentsUploaded  ApplicationDocument[]   @relation("DocumentUploadedBy")
}

// An agent refers customers/work to us. Agents don't have their own
// commission rate — instead, each Service defines a fixed "agent price"
// (see Service model below) which is simply the discounted rate we
// charge when the work comes through any agent. Tracked per applied
// service (not per customer) so a single customer can come via
// different agents for different services.
model Agent {
  id        String   @id @default(cuid())
  agentCode String   @unique // AGT-000001
  name      String
  // Mandatory for every newly created agent (enforced in the API —
  // see app/api/agents/route.ts). Defaults to "" only so that
  // existing rows created before this field existed don't become
  // invalid at migration time; they'll show a blank value in the UI
  // until edited, rather than the migration failing or losing data.
  enterpriseName String  @default("")
  mobile         String
  altMobile String?
  email     String?
  address   String?
  city      String?
  state     String?

  status AgentStatus @default(ACTIVE)
  notes  String?

  // Optional login for this agent. When set, that User (role=AGENT)
  // can log in and see only this agent's own dashboard/applications.
  // An agent can exist without a login (referral-only, added before
  // this feature, or intentionally never given portal access).
  userId String? @unique
  user   User?   @relation("AgentUserAccount", fields: [userId], references: [id])

  createdById String
  createdBy   User     @relation("AgentCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  customerServices CustomerService[]
  paymentRequests  AgentPaymentRequest[]

  @@index([name])
  @@index([mobile])
}

model Customer {
  id           String   @id @default(cuid())
  customerCode String   @unique // CUS-000001
  fullName     String
  mobile       String
  altMobile    String?
  email        String?
  address      String?
  village      String?
  tehsil       String?
  district     String?
  state        String?
  pincode      String?
  dob          DateTime?
  gender       String?
  notes        String?

  createdById String
  createdBy   User     @relation("CustomerCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  updatedById String?
  updatedBy   User?    @relation("CustomerUpdatedBy", fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime? // soft delete

  services CustomerService[]

  @@index([mobile])
  @@index([fullName])
}

// Every service has two fixed prices: what a normal (walk-in) customer
// pays, and what we charge when the work comes through an agent. There
// is no commission math anywhere — the agent price IS the price, set
// here by Admin/Manager, and the system picks the right one
// automatically based on whether a CustomerService has an agentId.
model Service {
  id            String   @id @default(cuid())
  name          String   @unique
  code          String   @unique
  description   String?
  customerPrice Decimal  @default(0) @db.Decimal(10, 2)
  agentPrice    Decimal  @default(0) @db.Decimal(10, 2)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  customerServices CustomerService[]

  // Configurable per service — this is what makes the application
  // form and document checklist dynamic instead of hard-coded per
  // service name. See ServiceField / ServiceDocumentRequirement below.
  fields                ServiceField[]
  documentRequirements  ServiceDocumentRequirement[]
}

// A single dynamic field on a service's application form (e.g.
// Passport's "ARN", Domicile's "User ID"). Admin/Manager-configured;
// the application form and review screens render these generically —
// no per-service code branching anywhere.
model ServiceField {
  id        String           @id @default(cuid())
  serviceId String
  service   Service          @relation(fields: [serviceId], references: [id])

  name  String // machine key, e.g. "arn" — stable once created
  label String // display label, e.g. "ARN / Application Reference Number"
  fieldType ServiceFieldType @default(TEXT)
  options   Json? // for SELECT fields: string[] of choices

  // Whether the Agent must fill this in before they can submit the
  // application at all. Fields not required at submission (e.g. a
  // Passport's "File Number") can still be filled in later by staff.
  requiredAtSubmission    Boolean @default(false)
  editableAfterSubmission Boolean @default(true)

  visibleToAgent    Boolean @default(true)
  visibleToEmployee Boolean @default(true)
  visibleToAdmin    Boolean @default(true)

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  values ApplicationFieldValue[]

  @@unique([serviceId, name])
  @@index([serviceId])
}

// A single document requirement on a service (e.g. PAN Card needs
// "Aadhaar Card" required + "Photo" optional). Admin/Manager-
// configured; the agent's upload form and the staff review screen
// both render this list generically.
model ServiceDocumentRequirement {
  id        String  @id @default(cuid())
  serviceId String
  service   Service @relation(fields: [serviceId], references: [id])

  name      String
  required  Boolean @default(true)
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents ApplicationDocument[]

  @@unique([serviceId, name])
  @@index([serviceId])
}

// One submitted value for one dynamic field on one application.
model ApplicationFieldValue {
  id                 String       @id @default(cuid())
  customerServiceId  String
  customerService    CustomerService @relation(fields: [customerServiceId], references: [id])
  serviceFieldId     String
  serviceField       ServiceField @relation(fields: [serviceFieldId], references: [id])

  value String? // stored as text regardless of field type; the form casts on display

  updatedById String?
  updatedBy   User?    @relation("FieldValueUpdatedBy", fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt

  @@unique([customerServiceId, serviceFieldId])
}

// One uploaded document on one application. requirementId links it
// to a configured ServiceDocumentRequirement when it satisfies one;
// null means it's a common optional document (Aadhaar/Photo/
// Signature) or a fully custom one the Agent named themselves — both
// are stored the same way, distinguished only by documentName.
model ApplicationDocument {
  id                String                      @id @default(cuid())
  customerServiceId String
  customerService   CustomerService             @relation(fields: [customerServiceId], references: [id])
  requirementId     String?
  requirement       ServiceDocumentRequirement? @relation(fields: [requirementId], references: [id])

  documentName String
  fileUrl      String

  uploadedById String
  uploadedBy   User     @relation("DocumentUploadedBy", fields: [uploadedById], references: [id])
  uploadedAt   DateTime @default(now())

  @@index([customerServiceId])
}

// One row = one "customer applied for a service" instance.
// A customer can have many of these (many services over time).
model CustomerService {
  id       String @id @default(cuid())
  workCode String @unique // WRK-000001

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  serviceId String
  service   Service @relation(fields: [serviceId], references: [id])

  // Which agent referred this particular applied service (optional —
  // walk-in / direct customers have none).
  agentId String?
  agent   Agent?  @relation(fields: [agentId], references: [id])

  // Which employee this work is assigned to. Nullable — unassigned
  // work sits in a shared queue until an admin/manager assigns it.
  assignedEmployeeId String?
  assignedEmployee   User?   @relation("CSAssignedEmployee", fields: [assignedEmployeeId], references: [id])

  status          ServiceStatus @default(NEW)
  referenceNumber String? // filled in after online submission / completion
  // Set when status = REJECTED (by whoever rejects it). Shown
  // prominently to the Agent so they know what to fix before
  // resubmitting. Cleared automatically on resubmit.
  rejectionReason String?
  // The actual price charged for this work item. Auto-filled at creation
  // from Service.agentPrice (if agentId is set) or Service.customerPrice
  // (if not) — see the apply-service API. Admin/Manager can override it.
  amount          Decimal?      @db.Decimal(10, 2)
  notes           String?

  // What the customer has actually paid us for this work item, and
  // how much is still pending. This is the single source of truth for
  // "how much payment is pending from this agent's work" — sum
  // (amount - amountReceived) across an agent's CustomerServices.
  amountReceived Decimal?      @default(0) @db.Decimal(10, 2)
  paymentStatus  PaymentStatus @default(PENDING)

  appliedDate    DateTime  @default(now())
  // Set the moment this application first becomes balance-eligible
  // (see lib/agentContext.ts) — for staff-created work, that's at
  // creation; for agent-submitted work, that's when it's accepted.
  // This is what "how many days has this agent's payment been
  // pending" is measured from — a real ledger timestamp, not a
  // derived/estimated one.
  acceptedAt     DateTime?
  expectedDate   DateTime?
  completedDate  DateTime?

  createdById String
  createdBy   User   @relation("CSCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  updatedById String?
  updatedBy   User?    @relation("CSUpdatedBy", fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt

  deletedAt DateTime?

  fieldValues ApplicationFieldValue[]
  documents   ApplicationDocument[]

  @@index([customerId])
  @@index([status])
  @@index([agentId])
  @@index([assignedEmployeeId])
}

// Business UPI ID used to generate payment QR codes for agents.
// Admin/Manager only. Kept as a small history (not a single mutable
// row) so past configuration is auditable, but only the most recent
// row with isActive=true is ever used to generate a QR.
model UpiConfig {
  id        String   @id @default(cuid())
  upiId     String // e.g. business@upi
  payeeName String? // shown in the UPI app as the payee
  isActive  Boolean  @default(true)

  updatedById String
  updatedBy   User     @relation("UpiConfigUpdatedBy", fields: [updatedById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// The manual payment-verification audit trail. An Agent submits one
// of these after paying via UPI — UTR + screenshot only, NEVER an
// amount (the agent cannot tell the system how much they paid).
// A Manager/Admin later verifies the real transaction and enters the
// actual amount, then approves or rejects. Only an APPROVED row's
// verifiedAmount counts toward the agent's "received" total — this
// row IS the payment record; there is no separate ledger table, so
// there is exactly one place payment history lives.
model AgentPaymentRequest {
  id            String               @id @default(cuid())
  agentId       String
  agent         Agent                @relation(fields: [agentId], references: [id])
  utrNumber     String
  screenshotUrl String
  status        PaymentRequestStatus @default(PENDING_VERIFICATION)

  // Set only by Manager/Admin on verification — never supplied by
  // the agent. This is the figure that actually reduces the agent's
  // pending balance, and only once status = APPROVED.
  verifiedAmount  Decimal?  @db.Decimal(10, 2)
  verifiedById    String?
  verifiedBy      User?     @relation("PaymentVerifiedBy", fields: [verifiedById], references: [id])
  verifiedAt      DateTime?
  rejectionReason String?

  submittedById String
  submittedBy   User     @relation("PaymentSubmittedBy", fields: [submittedById], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([agentId])
  @@index([status])
}

// Polymorphic-ish audit trail: every important create/status
// change writes a row here. entityType + entityId identify the
// record; previousValue/newValue hold JSON snapshots.
model ActivityLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  action     String   // e.g. "CUSTOMER_CREATED", "SERVICE_STATUS_CHANGED"
  entityType String   // "Customer" | "CustomerService"
  entityId   String
  previousValue Json?
  newValue      Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
}
